#Область ВыполнитьЗапись

Функция ПолучитьДанныеРС(п_Номенклатура)

	Рез = Новый Структура("ОЗОН, ОЗОН_Комиссия, ЯНДЕКС, ЯНДЕКС_Комиссия, Wildberries, Wildberries_Комиссия, СБЕР, СБЕР_Комиссия",
	"",0, "",0, "",0, "",0);
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	QW_КомиссияМаркетплейсов.Номенклатура КАК Номенклатура,
		|	QW_КомиссияМаркетплейсов.ОЗОН КАК ОЗОН,
		|	QW_КомиссияМаркетплейсов.ОЗОН_Комиссия КАК ОЗОН_Комиссия,
		|	QW_КомиссияМаркетплейсов.ЯНДЕКС КАК ЯНДЕКС,
		|	QW_КомиссияМаркетплейсов.ЯНДЕКС_Комиссия КАК ЯНДЕКС_Комиссия,
		|	QW_КомиссияМаркетплейсов.Wildberries КАК Wildberries,
		|	QW_КомиссияМаркетплейсов.Wildberries_Комиссия КАК Wildberries_Комиссия,
		|	QW_КомиссияМаркетплейсов.СБЕР КАК СБЕР,
		|	QW_КомиссияМаркетплейсов.СБЕР_Комиссия КАК СБЕР_Комиссия
		|ИЗ
		|	РегистрСведений.QW_КомиссияМаркетплейсов КАК QW_КомиссияМаркетплейсов
		|ГДЕ
		|	QW_КомиссияМаркетплейсов.Номенклатура = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", п_Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Рез, Выборка);
	КонецЕсли;

	Возврат Рез;

КонецФункции // ()


&НаСервере
Функция ВыполнитьЗаписьНаСервере()

	КоличествоЗаписанныхСтрок = 0;
	
	УстановитьПривилегированныйРежим(Истина);
	
    Для каждого Т Из Объект.ТЗ Цикл
        
        Если НЕ Т.Выбран Тогда
            Продолжить;
        КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(Т.Номенклатура) Тогда
            Продолжить;
        КонецЕсли; 

		Рез = ПолучитьДанныеРС(Т.Номенклатура);
		
		МЗ = РегистрыСведений.QW_КомиссияМаркетплейсов.СоздатьМенеджерЗаписи();
		
		ЗаполнитьЗначенияСвойств(МЗ, Рез);
		
		МЗ.Номенклатура = Т.Номенклатура;
		
		Если Маркетплейс = "ОЗОН" Тогда
			МЗ.ОЗОН				= Т.Категория;
			МЗ.ОЗОН_Комиссия	= Т.Комиссия;
		ИначеЕсли Маркетплейс = "ЯНДЕКС" Тогда
			МЗ.ЯНДЕКС			= Т.Категория;
			МЗ.ЯНДЕКС_Комиссия	= Т.Комиссия;
		ИначеЕсли Маркетплейс = "Wildberries" Тогда
			МЗ.Wildberries			= Т.Категория;
			МЗ.Wildberries_Комиссия	= Т.Комиссия;
		ИначеЕсли Маркетплейс = "СБЕР" Тогда
			МЗ.СБЕР				= Т.Категория;
			МЗ.СБЕР_Комиссия	= Т.Комиссия;
		Иначе                
			Продолжить;
		КонецЕсли;

		МЗ.Записать();
		
		КоличествоЗаписанныхСтрок = КоличествоЗаписанныхСтрок + 1;
		
	КонецЦикла; 
	
	Возврат КоличествоЗаписанныхСтрок;
	
КонецФункции

&НаКлиенте
Процедура КомандаВыполнитьЗапись(Команда)

	Если НЕ ЗначениеЗаполнено(Маркетплейс) Тогда
		ПоказатьПредупреждение(, "Не выбран маркетплейс", 1);
		Возврат;
	КонецЕсли;
	
	КоличествоЗаписанныхСтрок = ВыполнитьЗаписьНаСервере();
	
	Если КоличествоЗаписанныхСтрок = 0 Тогда
		ПоказатьПредупреждение(, "Нет строк, отмеченных для записи", 1);
	Иначе
		ПоказатьПредупреждение(, "Записано строк: " + КоличествоЗаписанныхСтрок, 1);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область ЗагрузитьФайл

&НаСервере

Процедура ЗагрузитьСтроку(ТабличныйДокумент, НомерСтроки)
	
	кол_Номенклатура	= 1;
	кол_Категория		= 2;
	кол_Комиссия		= 3;
	
	// Номенклатура
	Область = ТабличныйДокумент.ПолучитьОбласть("R" + СтрЗаменить(НомерСтроки, Символы.НПП, "") + "C" + кол_Номенклатура);
	ТекущаяОбласть = Область.ТекущаяОбласть;
	с_Номенклатура = УдалитьНеразрывныеПробелы(СокрЛП(ТекущаяОбласть.Текст));
	
	// Категория
	Область = ТабличныйДокумент.ПолучитьОбласть("R" + СтрЗаменить(НомерСтроки, Символы.НПП, "") + "C" + кол_Категория);
	ТекущаяОбласть = Область.ТекущаяОбласть;
	с_поле = СокрЛП(ТекущаяОбласть.Текст);
    с_Категория = УдалитьНеразрывныеПробелы(с_поле);

	// Процент
	Область = ТабличныйДокумент.ПолучитьОбласть("R" + СтрЗаменить(НомерСтроки, Символы.НПП, "") + "C" + кол_Комиссия);
	ТекущаяОбласть = Область.ТекущаяОбласть;
	с_поле = СокрЛП(ТекущаяОбласть.Текст);
    с_Комиссия = УдалитьНеразрывныеПробелы(с_поле);
	
	Если ПустаяСтрока(с_Номенклатура) И ПустаяСтрока(с_Категория) И ПустаяСтрока(с_Комиссия) Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = Объект.ТЗ.Добавить();
	
	НоваяСтрока.Категория	= с_Категория;
	НоваяСтрока.Комиссия	= с_Комиссия;
	
	ТекСпр = Справочники.Номенклатура.НайтиПоНаименованию(с_Номенклатура, Истина);
	                          
	Если ЗначениеЗаполнено(ТекСпр) Тогда
		НоваяСтрока.Номенклатура	= ТекСпр;
		НоваяСтрока.Выбран		 	= Истина;
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьФайлНаСервере(АдресВременногоХранилищаФайла)
	
	ИмяВременногоФайла  = ПолучитьИмяВременногоФайла("xls");
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаФайла);
	ДвоичныеДанныеФайла.Записать(ИмяВременногоФайла);
	
	ПерваяСтрокаДляЗагрузки = 2;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
    Попытка
        ТабличныйДокумент.Прочитать(ИмяВременногоФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
    Исключение
        УдалитьФайлы(ИмяВременногоФайла);
        Возврат "Не удалось прочитать файл: " + ОписаниеОшибки();
    КонецПопытки;	
	
	УдалитьФайлы(ИмяВременногоФайла);
	
    КоличествоСтрок = ТабличныйДокумент.ВысотаТаблицы;
	
	Если КоличествоСтрок = 0 Тогда
		Возврат "В файле нет строк";
	КонецЕсли;          
	
	Объект.ТЗ.Очистить();
	
	НомерСтроки = ПерваяСтрокаДляЗагрузки;
	
	Пока НомерСтроки <= КоличествоСтрок Цикл
		
		ЗагрузитьСтроку(ТабличныйДокумент, НомерСтроки);
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	КоличествоНенайденныхНоменклатур = 0;
	
	Для Каждого СтрокаТЗ Из Объект.ТЗ Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЗ.Номенклатура) Тогда
			КоличествоНенайденныхНоменклатур = КоличествоНенайденныхНоменклатур + 1;
		КонецЕсли;
	КонецЦикла;
	
	ТекстИтога = "Загружено строк: " + Объект.ТЗ.Количество();
	
	Если КоличествоНенайденныхНоменклатур > 0 Тогда
		ТекстИтога = ТекстИтога + ", из них без номенклатуры: " + КоличествоНенайденныхНоменклатур;
	КонецЕсли;
	
	Возврат ТекстИтога;
	
КонецФункции

&НаКлиенте
Процедура ЗагрузитьФайл(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.ПутьКФайлу) Тогда
		ПоказатьПредупреждение(, "Не выбран файл для загрузки", 1);
		Возврат;
	КонецЕсли;
	
	ДвДанные = Новый ДвоичныеДанные(Объект.ПутьКФайлу);
	
	АдресВременногоХранилищаФайла = ПоместитьВоВременноеХранилище(ДвДанные, Новый УникальныйИдентификатор);
	
	ТекстСообщения = ЗагрузитьФайлНаСервере(АдресВременногоХранилищаФайла);
	
	Если НЕ ПустаяСтрока(ТекстСообщения) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
	КонецЕсли;

	Если Объект.ТЗ.Количество() > 0 Тогда
		ПоказатьПредупреждениеОГруппахНоменклатуры();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПредупреждениеОГруппахНоменклатуры()

	РезультатПроверки = ПроверитьГруппыНоменклатуры();

	Если ПустаяСтрока(РезультатПроверки.ТекстПредупреждения) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ТекстСообщения Из РезультатПроверки.Сообщения Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
	КонецЦикла;

	ПоказатьПредупреждение(, РезультатПроверки.ТекстПредупреждения);

КонецПроцедуры

#КонецОбласти 


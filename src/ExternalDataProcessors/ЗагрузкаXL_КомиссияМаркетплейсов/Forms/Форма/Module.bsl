#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПроверитьГруппыНоменклатуры()

	ГруппыПоНаименованию = ДанныеГруппНоменклатуры();

	Сообщения = Новый Массив;
	КоличествоДублей = 0;
	ПомеченныеНаУдаление = Новый Массив;

	Для Каждого ЭлементСоответствия Из ГруппыПоНаименованию Цикл

		ОдноименныеГруппы = ЭлементСоответствия.Значение;

		Если ОдноименныеГруппы.Количество() <= 1 Тогда
			Продолжить;
		КонецЕсли;

		КоличествоДублей = КоличествоДублей + 1;
		Сообщения.Добавить(СтрШаблон("Дубль наименования группы (совпадений: %1):", ОдноименныеГруппы.Количество()));

		Для Каждого Группа Из ОдноименныеГруппы Цикл

			Сообщения.Добавить("    " + Группа.Описание);

			Если Группа.ПометкаУдаления Тогда
				ПомеченныеНаУдаление.Добавить(Группа.Описание);
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Если ПомеченныеНаУдаление.Количество() > 0 Тогда

		Сообщения.Добавить(СтрШаблон("Из дублей помечены на удаление: %1", ПомеченныеНаУдаление.Количество()));

		Для Каждого Описание Из ПомеченныеНаУдаление Цикл
			Сообщения.Добавить("    " + Описание);
		КонецЦикла;

	КонецЕсли;

	ТекстПредупреждения = ТекстПредупрежденияОГруппах(КоличествоДублей, ПомеченныеНаУдаление.Количество());

	Результат = Новый Структура("ТекстПредупреждения, Сообщения", ТекстПредупреждения, Сообщения);

	Возврат Результат;

КонецФункции

&НаСервере
Функция ДанныеГруппНоменклатуры()

	СсылкиНоменклатуры = Новый Массив;

	Для Каждого СтрокаТЗ Из Объект.ТЗ Цикл
		Если ЗначениеЗаполнено(СтрокаТЗ.Номенклатура) Тогда
			СсылкиНоменклатуры.Добавить(СтрокаТЗ.Номенклатура);
		КонецЕсли;
	КонецЦикла;

	ГруппыПоНаименованию = Новый Соответствие;

	Если СсылкиНоменклатуры.Количество() = 0 Тогда
		Возврат ГруппыПоНаименованию;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Группы.Код КАК Код,
		|	Группы.Наименование КАК Наименование,
		|	Группы.ПометкаУдаления КАК ПометкаУдаления,
		|	Группы.Родитель.Наименование КАК РодительНаименование
		|ИЗ
		|	Справочник.Номенклатура КАК Группы
		|ГДЕ
		|	Группы.ЭтоГруппа = ИСТИНА
		|	И Группы.Наименование В
		|		(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			ЗагруженнаяНоменклатура.Наименование
		|		ИЗ
		|			Справочник.Номенклатура КАК ЗагруженнаяНоменклатура
		|		ГДЕ
		|			ЗагруженнаяНоменклатура.Ссылка В (&СсылкиНоменклатуры))";

	Запрос.УстановитьПараметр("СсылкиНоменклатуры", СсылкиНоменклатуры);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		ОписаниеГруппы = СтрШаблон("%1 (код %2)", СокрЛП(Выборка.Наименование), СокрЛП(Выборка.Код));

		Если ЗначениеЗаполнено(Выборка.РодительНаименование) Тогда
			ОписаниеГруппы = ОписаниеГруппы + ", родитель: " + СокрЛП(Выборка.РодительНаименование);
		КонецЕсли;

		Группа = Новый Структура("Описание, ПометкаУдаления", ОписаниеГруппы, Выборка.ПометкаУдаления);

		Ключ = ВРег(СокрЛП(Выборка.Наименование));
		ОдноименныеГруппы = ГруппыПоНаименованию.Получить(Ключ);

		Если ОдноименныеГруппы = Неопределено Тогда
			ОдноименныеГруппы = Новый Массив;
			ГруппыПоНаименованию.Вставить(Ключ, ОдноименныеГруппы);
		КонецЕсли;

		ОдноименныеГруппы.Добавить(Группа);

	КонецЦикла;

	Возврат ГруппыПоНаименованию;

КонецФункции

&НаСервере
Функция ТекстПредупрежденияОГруппах(КоличествоДублей, КоличествоПомеченных)

	ЧастиТекста = Новый Массив;

	Если КоличествоДублей > 0 Тогда
		ЧастиТекста.Добавить(СтрШаблон("Дубли наименований групп среди загруженных: %1.", КоличествоДублей));
	КонецЕсли;

	Если КоличествоПомеченных > 0 Тогда
		ЧастиТекста.Добавить(СтрШаблон("Из них помечено на удаление: %1.", КоличествоПомеченных));
	КонецЕсли;

	Если ЧастиТекста.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	ЧастиТекста.Добавить("Подробности в панели сообщений.");


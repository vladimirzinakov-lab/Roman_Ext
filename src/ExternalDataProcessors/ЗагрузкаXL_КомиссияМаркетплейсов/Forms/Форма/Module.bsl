	    КонецЦикла;
	Иначе
	    Для Каждого НомерСтроки Из МассивСтрок Цикл
	        СтрокаТЧ = Объект.ТЗ.НайтиПоИдентификатору(НомерСтроки);
	        СтрокаТЧ.Выбран = Истина;
	    КонецЦикла;
    КонецЕсли;

КонецПроцедуры

&НаСервере
Функция УдалитьНеразрывныеПробелы(с_поле)
	
	Возврат СтрЗаменить(с_поле, Символы.НПП, "");
	
